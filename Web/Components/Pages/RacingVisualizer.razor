@page "/racing"
@inject SimulationService Sim
@inject IJSRuntime JS
@using System.Timers
@using Web.Data
@using Web.Services
@using Web.Services.Scenarios
@implements IDisposable

<PageTitle>Перегони - Лабораторія MPC</PageTitle>

<div class="visualizer-container">
    <div class="simulation-area">
        <div class="simulation-header">
            <h1 class="simulation-title">Перегони</h1>
        </div>

        <div class="canvas-wrapper">
            <canvas id="raceCanvas"></canvas>
        </div>

        <div class="control-buttons">
            <div class="button-group">
                <button class="btn @(_isRunning ? "btn-danger" : "btn-success")" @onclick="ToggleSim">
                    @(_isRunning ? "Стоп" : "Старт")
                </button>
                <button class="btn btn-secondary" @onclick="ClearTrail">Очистити шлях</button>
            </div>

            @if (_trackExists)
            {
                <span class="track-status ready">Шлях готовий</span>
            }
            else
            {
                <span class="track-status waiting">Намалюйте замкнутий шлях</span>
            }

            <button class="btn btn-outline-danger" @onclick="ResetTrack">Скинути</button>
        </div>
    </div>

    <div class="control-panel">
        <div class="panel-header">
            <h2 class="panel-title">Керування</h2>
        </div>

        <div class="panel-content">
            @if (Context != null)
            {
                <section class="control-section">
                    <h3 class="section-title">Тип автомобіля</h3>
                    <div class="btn-group" style="width: 100%; margin-bottom: 1rem;">
                        <button class="btn btn-sm @(Context.CurrentCarType == Enums.CarType.GoKart ? "btn-primary" : "btn-secondary")"
                                @onclick='() => SetCarType(Enums.CarType.GoKart)' style="flex: 1;">
                            Карт
                        </button>
                        <button class="btn btn-sm @(Context.CurrentCarType == Enums.CarType.Sedan ? "btn-primary" : "btn-secondary")"
                                @onclick='() => SetCarType(Enums.CarType.Sedan)' style="flex: 1;">
                            Легковий
                        </button>
                        <button class="btn btn-sm @(Context.CurrentCarType == Enums.CarType.Limo ? "btn-primary" : "btn-secondary")"
                                @onclick='() => SetCarType(Enums.CarType.Limo)' style="flex: 1;">
                            Вантажний
                        </button>
                    </div>
                </section>

                <section class="control-section">
                    <h3 class="section-title">Налаштування точності</h3>

                    <div class="control-group">
                        <label class="control-label">Позиція</label>
                        <input type="number" class="form-control" step="1"
                               @bind-value="Context.PrecisionPosition" @bind-value:event="oninput" />
                    </div>

                    <div class="control-group">
                        <label class="control-label">Швидкість</label>
                        <input type="number" class="form-control" step="1"
                               @bind-value="Context.PrecisionVelocity" @bind-value:event="oninput" />
                    </div>

                    <div class="control-group">
                        <label class="control-label">Кут</label>
                        <input type="number" class="form-control" step="10"
                               @bind-value="Context.PrecisionAngle" @bind-value:event="oninput" />
                    </div>
                </section>

                <section class="control-section">
                    <h3 class="section-title">Плавність</h3>

                    <div class="control-group">
                        <label class="control-label">Прискорення</label>
                        <input type="number" class="form-control" step="0.1"
                               @bind-value="Context.SmoothnessAccel" @bind-value:event="oninput" />
                    </div>

                    <div class="control-group">
                        <label class="control-label">Кермування</label>
                        <input type="number" class="form-control" step="100"
                               @bind-value="Context.SmoothnessSteering" @bind-value:event="oninput" />
                    </div>
                </section>

                <section class="control-section">
                    <h3 class="section-title">Симуляція</h3>

                    <div class="control-group">
                        <label class="control-label">
                            <span>Горизонт</span>
                            <span class="control-value">@Context.Horizon</span>
                        </label>
                        <input type="range" class="form-range" min="10" max="60" step="1" @bind-value="Context.Horizon" @bind-value:event="oninput" />
                    </div>

                    <div class="control-group">
                        <label class="control-label">
                            <span>Крок часу (dt)</span>
                            <span class="control-value">@Sim.Dt.ToString("F3")</span>
                        </label>
                        <input type="range" class="form-range" min="0.01" max="0.2" step="0.01" @bind-value="Sim.Dt" @bind-value:event="oninput" />
                    </div>
                </section>
            }
            else
            {
                <section class="control-section">
                    <h3 class="section-title">Інструкції</h3>
                    <p style="font-size: 0.8125rem; color: var(--text-light); line-height: 1.5;">
                        Натисніть і потягніть на полотні, щоб намалювати гоночний трек. Замкніть петлю, з'єднавши з початком.
                    </p>
                </section>
            }

            @if (_currentCar != null)
            {
                <div class="telemetry-panel">
                    <h3 class="telemetry-title">Телеметрія</h3>
                    <div class="telemetry-grid">
                        <div class="telemetry-item">
                            <div class="telemetry-label">X</div>
                            <div class="telemetry-value">@(_currentCar.X.ToString("F2"))</div>
                        </div>
                        <div class="telemetry-item">
                            <div class="telemetry-label">Y</div>
                            <div class="telemetry-value">@(_currentCar.Y.ToString("F2"))</div>
                        </div>
                        <div class="telemetry-item">
                            <div class="telemetry-label">Швидкість</div>
                            <div class="telemetry-value">@(Math.Abs(_currentCar.Velocity).ToString("F2"))</div>
                        </div>
                        <div class="telemetry-item">
                            <div class="telemetry-label">Кут</div>
                            <div class="telemetry-value">@(_currentCar.Theta.ToString("F2"))</div>
                        </div>
                    </div>
                </div>
            }
            <section class="control-section">
                <h3 class="section-title">Експорт Даних</h3>
                <div class="control-group">
                    <button class="btn btn-sm btn-outline-primary" style="width: 100%" @onclick="DownloadData">
                        Завантажити результати (.csv)
                    </button>
                </div>
            </section>
        </div>
    </div>
</div>

@code {
    private Timer? _timer;
    private CarStateDTO? _currentCar;
    private DotNetObjectReference<RacingVisualizer>? _objRef;
    private bool _isRunning = false;
    private bool _trackExists = false;

    private bool _disposed = false;

    private RacingScenario? Context => Sim.ActiveScenario as RacingScenario;

    protected override async Task OnInitializedAsync()
    {
        Sim.LoadScenario("racing");
        Sim.Dt = 0.1;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_disposed)
        {
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initCanvasEvents", "raceCanvas", _objRef);
            await DrawFrame();
        }
    }

    private void SetCarType(Enums.CarType type)
    {
        if (Context != null)
        {
            Context.CurrentCarType = type;
        }
    }

    [JSInvokable]
    public async Task Redraw()
    {
        await DrawFrame();
    }

    [JSInvokable]
    public async Task HandleMouseDown(double x, double y)
    {
        if (_disposed) 
        {
            return;
        }
        if (_isRunning)
        {
            return;
        }

        Sim.HandleInteraction(x, y, "StartDraw");
        await DrawFrame();
    }

    [JSInvokable]
    public async Task HandleMouseMove(double x, double y)
    {
        if (_disposed) 
        {
            return;
        }
        if (_isRunning)
        {
            return;
        }

        Sim.HandleInteraction(x, y, "Drawing");
        await DrawFrame();
    }

    [JSInvokable]
    public async Task HandleMouseUp()
    {
        if (_disposed) 
        {
            return;
        }
        if (_isRunning)
        {
            return;
        }

        Sim.HandleInteraction(0, 0, "EndDraw");

        var data = Sim.GetCurrentVisuals() as RacingVisuals;
        _trackExists = (data != null && data.Track != null && data.Track.Count > 0);

        await DrawFrame();
    }

    [JSInvokable]
    public void HandleRightClick(double x, double y)
    {
        // Not used in racing
    }

    private void ToggleSim()
    {
        if (_isRunning)
        {
            Stop();
        }
        else
        {
            Start();
        }
    }

    private void Start()
    {
        if (!_trackExists)
        {
            return;
        }
        if (_timer != null)
        {
            return;
        }

        _timer = new Timer(Sim.Dt * 1000);
        _timer.Elapsed += async (s, e) =>
        {
            if (_disposed)
            {
                Stop();
                return;
            }
            await Tick();
        };
        _timer.Start();
        _isRunning = true;
    }

    private void Stop()
    {
        _timer?.Stop();
        _timer = null;
        _isRunning = false;
    }

    private async Task Tick()
    {
        if (_disposed) 
        {
            return;
        }
        Sim.RunStep();
        await DrawFrame();
    }

    private async Task DrawFrame()
    {
        if (_disposed) 
        {
            return;
        }

        var baseDto = Sim.GetCurrentState();
        _currentCar = MapBaseToCar(baseDto);
        var visuals = Sim.GetCurrentVisuals();

        try
        {
            await JS.InvokeVoidAsync("drawRacing", "raceCanvas", _currentCar, visuals);
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private async Task ClearTrail()
    {
        if (_disposed) 
        {
            return;
        }
        Sim.HandleInteraction(0, 0, "ClearTrail");
        if (!_isRunning)
        {
            await DrawFrame();
        }
    }

    private void ResetTrack()
    {
        Stop();
        Sim.Reset();
        _trackExists = false;
        _ = DrawFrame();
    }

    private async Task DownloadData()
    {
        if (Context == null || _disposed)
        {
            return;
        }
        string csv = Context.GetCsv();
        string fileName = $"racing_data_{DateTime.Now:yyyy-MM-dd_HH-mm-ss}.csv";
        await JS.InvokeVoidAsync("downloadCsv", fileName, csv);
    }

    private CarStateDTO MapBaseToCar(BaseStateDTO baseDto)
    {
        var car = new CarStateDTO();
        car.State = new double[4];
        car.Control = new double[2];
        if (baseDto?.State != null)
        {
            for (int i = 0; i < Math.Min(baseDto.State.Length, 4); ++i)
            {
                car.State[i] = baseDto.State[i];
            }
        }
        if (baseDto?.Control != null)
        {
            for (int i = 0; i < Math.Min(baseDto.Control.Length, 2); ++i)
            {
                car.Control[i] = baseDto.Control[i];
            }
        }
        return car;
    }

    public void Dispose()
    {
        _disposed = true;
        Stop();
        try { ((IJSInProcessRuntime)JS).InvokeVoid("disposeCanvasEvents", "raceCanvas"); } catch { }
        _objRef?.Dispose();
    }
}