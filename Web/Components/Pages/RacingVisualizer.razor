@page "/racing"
@inject SimulationService Sim
@inject IJSRuntime JS
@using System.Timers
@using Web.Data
@using Web.Services
@using Web.Services.Scenarios
@implements IDisposable

<PageTitle>Racing - MPC Lab</PageTitle>

<div class="visualizer-container">
    <div class="simulation-area">
        <div class="simulation-header">
            <h1 class="simulation-title">Racing</h1>
        </div>

        <div class="canvas-wrapper">
            <canvas id="raceCanvas"></canvas>
        </div>

        <div class="control-buttons">
            <div class="button-group">
                <button class="btn @(_isRunning ? "btn-danger" : "btn-success")" @onclick="ToggleSim">
                    @(_isRunning ? "Stop" : "Start")
                </button>
                <button class="btn btn-secondary" @onclick="ResetTrack">Reset</button>
            </div>

            <div class="button-group" style="justify-self: center;">
                @if (_trackExists)
                {
                    <span class="badge bg-success">Track Ready</span>
                }
                else
                {
                    <span class="badge bg-info">Draw a loop</span>
                }
            </div>

            <button class="btn btn-outline-danger" @onclick="ResetTrack">Clear Track</button>
        </div>
    </div>

    <div class="control-panel">
        <div class="panel-content">
            <section class="control-section">
                <h3 class="section-title">Instructions</h3>
                <p style="font-size: 0.8125rem; color: var(--text-light); line-height: 1.5;">
                    Click and drag on the canvas to draw a racing track. Close the loop by connecting back to the start.
                </p>
            </section>
        </div>
    </div>
</div>

@code {
    private Timer? _timer;
    private DotNetObjectReference<RacingVisualizer>? _objRef;
    private bool _isRunning = false;
    private bool _trackExists = false;

    protected override async Task OnInitializedAsync()
    {
        Sim.SetScenario(new RacingScenario());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initCanvasEvents", "raceCanvas", _objRef);
            await DrawFrame();
        }
    }

    [JSInvokable]
    public async Task HandleMouseDown(double x, double y)
    {
        if (_isRunning) return;

        Sim.HandleInteraction(x, y, "StartDraw");
        await DrawFrame();
    }

    [JSInvokable]
    public async Task HandleMouseMove(double x, double y)
    {
        if (_isRunning) return;

        Sim.HandleInteraction(x, y, "Drawing");
        await DrawFrame();
    }

    [JSInvokable]
    public async Task HandleMouseUp()
    {
        if (_isRunning) return;

        Sim.HandleInteraction(0, 0, "EndDraw");

        var data = Sim.GetCurrentVisuals() as RacingVisuals;
        _trackExists = (data != null && data.Track != null && data.Track.Count > 0);

        await DrawFrame();
    }

    [JSInvokable]
    public void HandleRightClick(double x, double y)
    {
        // Not used in racing
    }

    private void ToggleSim()
    {
        if (_isRunning) Stop(); else Start();
    }

    private void Start()
    {
        if (!_trackExists) return;
        if (_timer != null) return;

        _timer = new Timer(Sim.Dt * 1000);
        _timer.Elapsed += async (s, e) => await Tick();
        _timer.Start();
        _isRunning = true;
    }

    private void Stop()
    {
        _timer?.Stop();
        _timer = null;
        _isRunning = false;
    }

    private async Task Tick()
    {
        Sim.RunStep();
        await DrawFrame();
    }

    private async Task DrawFrame()
    {
        var baseDto = Sim.GetCurrentState();
        var carDto = MapBaseToCar(baseDto);
        var visuals = Sim.GetCurrentVisuals();

        await JS.InvokeVoidAsync("drawRacing", "raceCanvas", carDto, visuals);
        await InvokeAsync(StateHasChanged);
    }

    private void ResetTrack()
    {
        Stop();
        Sim.Reset();
        _trackExists = false;
        _ = DrawFrame();
    }

    private CarStateDTO MapBaseToCar(BaseStateDTO baseDto)
    {
        var car = new CarStateDTO();
        car.State = new double[4];
        car.Control = new double[2];
        if (baseDto?.State != null)
        {
            for (int i = 0; i < Math.Min(baseDto.State.Length, 4); i++)
                car.State[i] = baseDto.State[i];
        }
        if (baseDto?.Control != null)
        {
            for (int i = 0; i < Math.Min(baseDto.Control.Length, 2); i++)
                car.Control[i] = baseDto.Control[i];
        }
        return car;
    }

    public void Dispose()
    {
        Stop();
        _objRef?.Dispose();
    }
}
