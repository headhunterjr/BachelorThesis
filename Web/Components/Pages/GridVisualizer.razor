@page "/grid"
@inject SimulationService Sim
@inject IJSRuntime JS
@using System.Timers
@using Web.Data
@using Web.Services
@using Web.Services.Scenarios
@implements IDisposable

<PageTitle>Електромережа - Лабораторія MPC</PageTitle>

<div class="visualizer-container">
    <div class="simulation-area">
        <div class="simulation-header">
            <h1 class="simulation-title">Оптимізація використання електроенергії</h1>
        </div>

        <div class="canvas-wrapper">
            <canvas id="gridCanvas"></canvas>
        </div>

        <div class="control-buttons">
            <div class="button-group">
                <button class="btn @(_isRunning ? "btn-danger" : "btn-success")" @onclick="ToggleSim">
                    @(_isRunning ? "Стоп" : "Старт")
                </button>
                <button class="btn btn-primary" @onclick="RunSingleStep">Крок (+@Sim.Dt.ToString("0.##") год)</button>
            </div>

            <button class="btn btn-secondary" style="margin-left: auto;" @onclick="Reset">Скинути</button>
        </div>
    </div>

    <div class="control-panel">
        <div class="panel-header">
            <h2 class="panel-title">Керування</h2>
        </div>

        <div class="panel-content">
            @if (Context != null)
            {
                <section class="control-section">
                    <h3 class="section-title">Середовище</h3>

                    <div class="control-group">
                        <label class="control-label">Пора року</label>
                        <select class="form-control" @bind="Context.Season" @bind:after='() => ToggleConfig("SetSeason:" + Context.Season)'>
                            <option value="Summer">Літо</option>
                            <option value="Spring">Весна</option>
                            <option value="Autumn">Осінь</option>
                            <option value="Winter">Зима</option>
                        </select>
                    </div>

                    <div class="toggle-row">
                        <label class="toggle-label" style="margin-bottom: 1.5rem;" for="cloudSwitch">Хмарна погода</label>
                        <div class="form-switch">
                            <input class="form-check-input" style="margin-bottom: 1.5rem;" type="checkbox" id="cloudSwitch"
                                   checked="@Context.IsCloudy"
                                   @onchange='() => ToggleConfig("ToggleCloudy")'>
                        </div>
                    </div>

                    <div class="control-group">
                        <label class="control-label">
                            <span>Похибка прогнозу</span>
                            <span class="control-value">@((Context.ForecastError * 100).ToString("F0"))%</span>
                        </label>
                        <input type="range" class="form-range" min="0.0" max="1.0" step="0.05"
                               @bind-value="Context.ForecastError"
                               @bind-value:event="oninput"
                               @onmouseup='() => ToggleConfig("Refresh")' />
                    </div>

                    <div class="control-group">
                        <label class="control-label">
                            <span>Статус мережі</span>
                            <span class="control-value" style="color: @(Context.IsBlackout ? "#EF4444" : "#10B981")">
                                @(Context.IsBlackout ? "Блекаут" : "Онлайн")
                            </span>
                        </label>
                        <button class="btn btn-sm @(Context.IsBlackout ? "btn-danger" : "btn-outline-danger")"
                                style="width: 100%"
                                @onclick='() => ToggleConfig("ToggleBlackout")'>
                            @(Context.IsBlackout ? "Скасувати блекаут" : "Симулювати блекаут")
                        </button>
                    </div>
                </section>

                <section class="control-section">
                    <h3 class="section-title">Обладнання</h3>

                    <div class="sub-control-section">
                        <div class="toggle-row">
                            <label class="toggle-label" for="solarSwitch">Сонячні панелі</label>
                            <div class="form-switch">
                                <input class="form-check-input" type="checkbox" id="solarSwitch"
                                       checked="@Context.HasSolar"
                                       @onchange='() => ToggleConfig("ToggleSolar")'>
                            </div>
                        </div>
                    </div>

                    <div class="sub-control-section">
                        <div class="toggle-row">
                            <label class="toggle-label" for="genSwitch">Дизельний генератор</label>
                            <div class="form-switch">
                                <input class="form-check-input" type="checkbox" id="genSwitch"
                                       checked="@Context.HasGenerator"
                                       @onchange='() => ToggleConfig("ToggleGen")'>
                            </div>
                        </div>

                        @if (Context.HasGenerator)
                        {
                            <div class="control-group">
                                <label class="control-label">Макс. потужність (кВт)</label>
                                <input type="number" class="form-control" step="5"
                                       @bind-value="Context.MaxGenPower" @bind-value:event="oninput" />
                            </div>
                        }
                    </div>

                    <div class="sub-control-section">
                        <h4 class="toggle-label">Батарея</h4>

                        <div class="control-group">
                            <label class="control-label">Ємність (кВт·год)</label>
                            <input type="number" class="form-control" step="10"
                                   @bind-value="Context.BatteryCapacity" @bind-value:event="oninput" />
                        </div>

                        <div class="control-group">
                            <label class="control-label">
                                <span>Ефективність (ККД)</span>
                                <span class="control-value">@((Context.BatteryEfficiency * 100).ToString("F0"))%</span>
                            </label>
                            <input type="range" class="form-range" min="0.7" max="1.0" step="0.01"
                                   @bind-value="Context.BatteryEfficiency" @bind-value:event="oninput" />
                        </div>
                    </div>

                    <div class="control-group">
                        <label class="control-label">Ліміт мережі (кВт)</label>
                        <input type="number" class="form-control" step="10"
                               @bind-value="Context.MaxGridPower" @bind-value:event="oninput" />
                    </div>
                </section>

                <section class="control-section">
                    <h3 class="section-title">Економіка</h3>

                    <div class="sub-control-section">
                        <div class="toggle-row">
                            <label class="toggle-label" for="peakSwitch">Піковий тариф</label>
                            <div class="form-switch">
                                <input class="form-check-input" type="checkbox" id="peakSwitch"
                                       @bind="Context.UsePeakPricing"
                                       @bind:after='() => ToggleConfig("Refresh")'>
                            </div>
                        </div>

                        @if (Context.UsePeakPricing)
                        {
                            <div class="control-group">
                                <label class="control-label">Ціна (День / Пік, $/кВт·год)</label>
                                <div style="display: flex; gap: 0.5rem;">
                                    <input type="number" class="form-control" step="0.01"
                                           @bind="Context.BasePrice"
                                           @bind:after='() => ToggleConfig("Refresh")'
                                           placeholder="День" />
                                    <input type="number" class="form-control" step="0.01"
                                           @bind="Context.PeakPrice"
                                           @bind:after='() => ToggleConfig("Refresh")'
                                           placeholder="Пік" />
                                </div>
                            </div>

                            <div class="control-group">
                                <label class="control-label">Години піку</label>
                                <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--text-light);">
                                    <input type="number" class="form-control" min="0" max="23"
                                           @bind="Context.PeakStartHour"
                                           @bind:after='() => ToggleConfig("Refresh")' />
                                    <span>—</span>
                                    <input type="number" class="form-control" min="0" max="23"
                                           @bind="Context.PeakEndHour"
                                           @bind:after='() => ToggleConfig("Refresh")' />
                                </div>
                            </div>
                        }
                    </div>

                    <div class="control-group">
                        <label class="control-label">Вартість дизеля ($/кВт·год)</label>
                        <input type="number" class="form-control" step="0.01" min="0"
                               @bind-value="Context.FuelCost" @bind-value:event="oninput"
                               @onchange='() => ToggleConfig("Refresh")' />
                    </div>
                </section>

                <section class="control-section">
                    <h3 class="section-title">Симуляція</h3>

                    <div class="control-group">
                        <label class="control-label">
                            <span>Горизонт</span>
                            <span class="control-value">@Context.Horizon год</span>
                        </label>
                        <input type="range" class="form-range" min="1" max="24" step="1"
                               @bind-value="Context.Horizon" @bind-value:event="oninput" />
                    </div>

                    <div class="control-group">
                        <label class="control-label">
                            <span>Крок (dt)</span>
                            <span class="control-value">@Sim.Dt.ToString("F2") год</span>
                        </label>
                        <select class="form-control" value="@Sim.Dt" @onchange="OnDtChanged">
                            <option value="1">1 година</option>
                            <option value="0.5">30 хвилин</option>
                            <option value="0.25">15 хвилин</option>
                        </select>
                    </div>

                    <div class="control-group">
                        <label class="control-label">
                            <span>Початковий заряд батареї</span>
                            <span class="control-value">@Context.InitialBatteryPercent.ToString("F0")%</span>
                        </label>
                        <input type="range" class="form-range" min="0" max="100" step="10"
                               @bind-value="Context.InitialBatteryPercent" @bind-value:event="oninput" />
                    </div>
                </section>

                <section class="control-section">
                    <h3 class="section-title">Плавність</h3>

                    <div class="control-group">
                        <label class="control-label">Використання мережі</label>
                        <input type="number" class="form-control" min="0.000" max="10.0" step="0.001"
                               @bind-value="Context.GridControlPenalty" @bind-value:event="onchange" />
                    </div>

                    <div class="control-group">
                        <label class="control-label">Використання генератора</label>
                        <input type="number" class="form-control" min="0.000" max="10.0" step="0.001"
                               @bind-value="Context.GenControlPenalty" @bind-value:event="onchange" />
                    </div>

                    <div class="control-group">
                        <label class="control-label">Утримання заряду</label>
                        <input type="number" class="form-control" min="0.0" max="10.0" step="0.001"
                               @bind-value="Context.BatteryAttraction" @bind-value:event="onchange" />
                    </div>

                    <div class="control-group">
                        <label class="control-label">Жорсткість обмежень</label>
                        <input type="number" class="form-control" step="100" min="100"
                               @bind-value="Context.ConstraintWeight" @bind-value:event="onchange" />
                    </div>
                </section>

                @if (_visuals != null)
                {
                    <div class="telemetry-panel">
                        <h3 class="telemetry-title">Результати</h3>
                        <div class="telemetry-grid">
                            <div class="telemetry-item">
                                <div class="telemetry-label">Час</div>
                                <div class="telemetry-value">@((_visuals.CurrentStep * Sim.Dt).ToString("F1")) год</div>
                            </div>
                            <div class="telemetry-item">
                                <div class="telemetry-label">Заряд</div>
                                <div class="telemetry-value">
                                    @(_visuals.PlannedBattery.ElementAtOrDefault(_visuals.CurrentStep > 0 ? _visuals.CurrentStep - 1 : 0).ToString("F1")) кВт·год
                                </div>
                            </div>
                            <div class="telemetry-item">
                                <div class="telemetry-label">Баланс</div>
                                <div class="telemetry-value" style="color: @(_visuals.CurrentCost > 0 ? "#F59E0B" : "#10B981"); grid-column: span 2;">
                                    @(_visuals.CurrentCost >= 0 ? "+" : "")$@(_visuals.CurrentCost.ToString("F2"))
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <section class="control-section">
                    <h3 class="section-title">Експорт даних</h3>
                    <div class="control-group">
                        <button class="btn btn-sm btn-outline-primary" style="width: 100%" @onclick="DownloadData">
                            Завантажити результати (.csv)
                        </button>
                    </div>
                </section>
            }
        </div>
    </div>
</div>

@code {
    private DotNetObjectReference<GridVisualizer>? _objRef;
    private GridVisuals? _visuals;
    private Timer? _timer;
    private bool _isRunning = false;
    private bool _disposed = false;

    private GridScenario? Context => Sim.ActiveScenario as GridScenario;

    protected override async Task OnInitializedAsync()
    {
        Sim.LoadScenario("grid");
        Sim.Dt = 1;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_disposed)
        {
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initCanvasEvents", "gridCanvas", _objRef);
            await UpdateVisuals();
        }
    }

    private async Task ToggleSim()
    {
        if (_isRunning) Stop();
        else await Start();
    }

    private async Task Start()
    {
        if (_timer != null || _disposed || Context == null) return;

        if (_visuals != null && (_visuals.CurrentStep * Sim.Dt) >= 24.0)
        {
            await Reset();
        }

        double dtForTimer = Math.Max(0.01, Sim.Dt);
        int tickSpeed = (int)(500 * dtForTimer);
        if (tickSpeed < 50) tickSpeed = 50;

        _timer = new Timer(tickSpeed);
        _timer.Elapsed += async (s, e) =>
        {
            if (_disposed) { Stop(); return; }
            await InvokeAsync(async () => await Tick());
        };
        _timer.Start();
        _isRunning = true;
    }

    private void Stop()
    {
        _timer?.Stop();
        _timer = null;
        _isRunning = false;
    }

    private async Task Tick()
    {
        if (_disposed || Context == null) return;

        Sim.RunStep();
        await UpdateVisuals();

        double currentHour = _visuals.CurrentStep * Sim.Dt;
        if (currentHour >= 24.0)
        {
            Stop();
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task RunSingleStep()
    {
        if (_visuals != null && (_visuals.CurrentStep * Sim.Dt) >= 24.0)
        {
            await Reset();
        }

        Stop();
        await Tick();
    }

    private async Task OnDtChanged(ChangeEventArgs e)
    {
        if (_disposed) return;
        if (e?.Value == null) return;

        if (double.TryParse(e.Value.ToString(), out var newDt) && newDt > 0)
        {
            if (_visuals != null && _visuals.CurrentStep > 0)
            {
                await Reset();
            }
            Sim.Dt = newDt;

            Sim.HandleInteraction(0, 0, $"SetDt:{newDt}");

            await UpdateVisuals();
        }
    }

    private async Task ToggleConfig(string? mode)
    {
        if (mode != null) Sim.HandleInteraction(0, 0, mode);
        else Sim.HandleInteraction(0, 0, "Refresh");

        await UpdateVisuals();
    }

    private async Task Reset()
    {
        if (_disposed) return;
        Stop();
        Sim.Reset();
        await UpdateVisuals();
    }

    private async Task DownloadData()
    {
        if (Context == null || _disposed) return;
        string csv = Context.GetCsv();
        string baseName = $"grid_data";
        await JS.InvokeVoidAsync("downloadCsv", baseName, csv);
    }

    private async Task UpdateVisuals()
    {
        if (_disposed) return;
        _visuals = Sim.GetCurrentVisuals() as GridVisuals;
        if (_visuals != null && !_disposed)
        {
            try { await JS.InvokeVoidAsync("drawGrid", "gridCanvas", _visuals); } catch { }
        }
        if (!_disposed) StateHasChanged();
    }

    [JSInvokable] public async Task Redraw() => await UpdateVisuals();
    [JSInvokable] public void HandleMouseDown(double x, double y) { }
    [JSInvokable] public void HandleMouseMove(double x, double y) { }
    [JSInvokable] public void HandleMouseUp() { }
    [JSInvokable] public void HandleRightClick(double x, double y) { }

    public void Dispose()
    {
        _disposed = true;
        Stop();
        try { ((IJSInProcessRuntime)JS).InvokeVoid("disposeCanvasEvents", "gridCanvas"); } catch { }
        _objRef?.Dispose();
    }
}
