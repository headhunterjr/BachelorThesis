@page "/datacenter"
@using Web.Services
@using Web.Services.Scenarios
@using Web.Data
@inject SimulationService Sim
@inject IJSRuntime JS
@implements IDisposable

<h3>Data Center Thermal MPC (Demo)</h3>

<div class="mb-2">
    <button class="btn btn-primary me-2" @onclick="UseBusyDay">Preset: Busy Day</button>
    <button class="btn btn-secondary me-2" @onclick="UseQuietNight">Preset: Quiet Night</button>
    <button class="btn btn-success me-2" @onclick="StartSim" disabled="@_running">Start</button>
    <button class="btn btn-danger me-2" @onclick="StopSim" disabled="!_running">Stop</button>
</div>

<div>
    <p><strong>Current Temperature:</strong> @_currentTempDisplayText</p>
    <p><strong>Applied Cooler Power (last):</strong> @_lastUDisplayText</p>
</div>

@code {
    private System.Timers.Timer? _timer;
    private bool _running = false;
    private double? _currentTemp = null;
    private double? _lastU = null;

    protected override void OnInitialized()
    {
        var dc = new DataCenterScenario();
        dc.HandleInteraction(0, 0, "Preset_BusyDay");
        Sim.SetScenario(dc);
    }

    private void UseBusyDay()
    {
        if (Sim.ActiveScenario is DataCenterScenario dc) dc.HandleInteraction(0, 0, "Preset_BusyDay");
    }

    private void UseQuietNight()
    {
        if (Sim.ActiveScenario is DataCenterScenario dc) dc.HandleInteraction(0, 0, "Preset_QuietNight");
    }

    private void StartSim()
    {
        if (_running) return;
        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += async (s, e) => await Tick();
        _timer.Start();
        _running = true;
    }

    private async Task Tick()
    {
        var dto = Sim.RunStep(); // now returns BaseStateDTO or subclass
        // dto.State contains the updated state (SimulationService populates State)
        if (dto.State != null && dto.State.Length > 0) _currentTemp = dto.State[0];
        if (dto.Control != null && dto.Control.Length > 0) _lastU = dto.Control[0];
        await InvokeAsync(StateHasChanged);
    }

    private void StopSim()
    {
        _timer?.Stop();
        _timer?.Dispose();
        _timer = null;
        _running = false;
    }

    private string _currentTempDisplayText => _currentTemp.HasValue ? $"{_currentTemp.Value:F2} °C" : "(n/a)";
    private string _lastUDisplayText => _lastU.HasValue ? $"{_lastU.Value:P0}" : "(n/a)";

    public void Dispose()
    {
        StopSim();
    }
}
