@page "/"
@using Web.Components.Layout
<PageTitle>Лабораторія MPC</PageTitle>

<div class="home-wrapper">
    <div class="header-section">
        <h1 class="main-title">Лабораторія MPC</h1>
        <p class="subtitle">Інтерактивний візуалізатор MPC — методу керування динамічними системами</p>
    </div>
    <div class="cards-grid">
        <a href="parking" class="sim-card">
            <div class="card-icon parking-icon">
                <SvgIcons Name="CardParking" ViewBox="0 0 24 24" />
            </div>
            <div class="card-content">
                <h3>Паркування</h3>
                <p>Точне планування шляху до заданої точки з урахуванням перешкод.</p>
            </div>
        </a>
        <a href="racing" class="sim-card">
            <div class="card-icon racing-icon">
                <SvgIcons Name="CardRacing" ViewBox="0 0 24 24" />
            </div>
            <div class="card-content">
                <h3>Перегони</h3>
                <p>Планування шляху автомобіля уздовж замкнутого гоночного треку.</p>
            </div>
        </a>
        <a href="grid" class="sim-card">
            <div class="card-icon grid-icon">
                <SvgIcons Name="CardGrid" ViewBox="0 0 24 24" />
            </div>
            <div class="card-content">
                <h3>Електромережа</h3>
                <p>Оптимізація використання електроенергії впродовж 24 годин.</p>
            </div>
        </a>
    </div>
</div>