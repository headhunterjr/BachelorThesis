@page "/"
<PageTitle>Home - MPC Control Lab</PageTitle>

<div class="home-container">
    <div class="hero-section">
        <div class="hero-content">
            <h1 class="hero-title">Model Predictive Control</h1>
            <p class="hero-subtitle">Interactive simulations for autonomous path tracking and obstacle avoidance</p>

            <div class="cta-buttons">
                <a href="/basicvisualizer" class="btn btn-primary btn-lg">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" style="margin-right: 0.5rem;">
                        <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
                    </svg>
                    Start Simulation
                </a>
                <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" class="btn btn-secondary btn-lg">
                    Learn More
                </a>
            </div>
        </div>

        <div class="hero-visual">
            <div class="floating-card card-1">
                <div class="card-icon">🚗</div>
                <div class="card-title">Parking</div>
            </div>
            <div class="floating-card card-2">
                <div class="card-icon">🏁</div>
                <div class="card-title">Racing</div>
            </div>
            <div class="floating-card card-3">
                <div class="card-icon">📊</div>
                <div class="card-title">Analysis</div>
            </div>
        </div>
    </div>

    <div class="features-section">
        <div class="feature-card">
            <div class="feature-icon purple">
                <svg width="32" height="32" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
                </svg>
            </div>
            <h3>Real-time Simulation</h3>
            <p>Watch MPC algorithms optimize paths in real-time with interactive visualizations</p>
        </div>

        <div class="feature-card">
            <div class="feature-icon cyan">
                <svg width="32" height="32" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1h4v1a2 2 0 11-4 0zM12 14c.015-.34.208-.646.477-.859a4 4 0 10-4.954 0c.27.213.462.519.476.859h4.002z" />
                </svg>
            </div>
            <h3>Parameter Tuning</h3>
            <p>Adjust algorithm parameters on the fly and observe their effects immediately</p>
        </div>

        <div class="feature-card">
            <div class="feature-icon emerald">
                <svg width="32" height="32" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M6 6V5a3 3 0 013-3h2a3 3 0 013 3v1h2a2 2 0 012 2v3.57A22.952 22.952 0 0110 13a22.95 22.95 0 01-8-1.43V8a2 2 0 012-2h2zm2-1a1 1 0 011-1h2a1 1 0 011 1v1H8V5zm1 5a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1z" clip-rule="evenodd" />
                    <path d="M2 13.692V16a2 2 0 002 2h12a2 2 0 002-2v-2.308A24.974 24.974 0 0110 15c-2.796 0-5.487-.46-8-1.308z" />
                </svg>
            </div>
            <h3>Interactive Controls</h3>
            <p>Add obstacles, move the vehicle, and create custom scenarios with simple clicks</p>
        </div>
    </div>
</div>
