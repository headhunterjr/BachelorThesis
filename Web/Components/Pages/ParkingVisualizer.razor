@page "/parking"
@inject SimulationService Sim
@inject IJSRuntime JS
@using System.Timers
@using Core
@using Web.Data
@using Web.Services
@using Web.Services.Scenarios
@implements IDisposable

<PageTitle>Паркування - Лабораторія MPC</PageTitle>

<div class="visualizer-container">
    <div class="simulation-area">
        <div class="simulation-header">
            <h1 class="simulation-title">Паркування</h1>
        </div>

        <div class="canvas-wrapper">
            <canvas id="simCanvas"></canvas>
        </div>

        <div class="control-buttons">
            <div class="button-group">
                <button class="btn btn-success" @onclick="Start">Старт</button>
                <button class="btn btn-danger" @onclick="Stop">Стоп</button>
                <button class="btn btn-secondary" @onclick="Reset">Скинути</button>
            </div>

            <div class="button-group">
                <button class="btn @(_mode == InteractionMode.AddObstacle ? "btn-warning" : "btn-info")" @onclick="SetAddObstacleMode">
                    @(_mode == InteractionMode.AddObstacle ? "Скасувати" : "Додати перешкоду")
                </button>
                <button class="btn @(_mode == InteractionMode.SetStart ? "btn-warning" : "btn-primary")" @onclick="SetStartPositionMode">
                    @(_mode == InteractionMode.SetStart ? "Скасувати" : "Перемістити авто")
                </button>
            </div>

            <button class="btn btn-outline-danger" @onclick="ClearObstacles">Очистити все</button>
        </div>
    </div>

    <div class="control-panel">
        <div class="panel-header">
            <h2 class="panel-title">Керування</h2>
        </div>

        <div class="panel-content">
            @if (Context != null)
            {
                <section class="control-section">
                    <h3 class="section-title">Тип автомобіля</h3>
                    <div class="btn-group" style="width: 100%; margin-bottom: 1rem;">
                        <button class="btn btn-sm @(Context.CurrentCarType == Enums.CarType.GoKart ? "btn-primary" : "btn-secondary")"
                                @onclick='() => SetCarType(Enums.CarType.GoKart)' style="flex: 1;">
                            Карт
                        </button>
                        <button class="btn btn-sm @(Context.CurrentCarType == Enums.CarType.Sedan ? "btn-primary" : "btn-secondary")"
                                @onclick='() => SetCarType(Enums.CarType.Sedan)' style="flex: 1;">
                            Седан
                        </button>
                        <button class="btn btn-sm @(Context.CurrentCarType == Enums.CarType.Limo ? "btn-primary" : "btn-secondary")"
                                @onclick='() => SetCarType(Enums.CarType.Limo)' style="flex: 1;">
                            Вантажний
                        </button>
                    </div>
                </section>

                <section class="control-section">
                    <h3 class="section-title">Налаштування точності</h3>

                    <div class="control-group">
                        <label class="control-label">Позиція (X/Y)</label>
                        <input type="number" class="form-control" step="1"
                               @bind-value="Context.PrecisionPosition" @bind-value:event="oninput" />
                    </div>

                    <div class="control-group">
                        <label class="control-label">Швидкість</label>
                        <input type="number" class="form-control" step="10"
                               @bind-value="Context.PrecisionVelocity" @bind-value:event="oninput" />
                    </div>

                    <div class="control-group">
                        <label class="control-label">Кут</label>
                        <input type="number" class="form-control" step="0.1"
                               @bind-value="Context.PrecisionAngle" @bind-value:event="oninput" />
                    </div>
                </section>

                <section class="control-section">
                    <h3 class="section-title">Плавність</h3>

                    <div class="control-group">
                        <label class="control-label">Прискорення</label>
                        <input type="number" class="form-control" step="0.1"
                               @bind-value="Context.SmoothnessAccel" @bind-value:event="oninput" />
                    </div>

                    <div class="control-group">
                        <label class="control-label">Кермування</label>
                        <input type="number" class="form-control" step="100"
                               @bind-value="Context.SmoothnessSteering" @bind-value:event="oninput" />
                    </div>
                </section>

                <section class="control-section">
                    <h3 class="section-title">Симуляція</h3>

                    <div class="control-group">
                        <label class="control-label">
                            <span>Горизонт</span>
                            <span class="control-value">@Context.Horizon</span>
                        </label>
                        <input type="range" class="form-range" min="10" max="100" step="1" @bind-value="Context.Horizon" @bind-value:event="oninput" />
                    </div>

                    <div class="control-group">
                        <label class="control-label">
                            <span>Крок часу (dt)</span>
                            <span class="control-value">@Sim.Dt.ToString("F3")</span>
                        </label>
                        <input type="range" class="form-range" min="0.01" max="0.2" step="0.01" @bind-value="Sim.Dt" @bind-value:event="oninput" />
                    </div>
                </section>

                <section class="control-section">
                    <h3 class="section-title">Перешкоди</h3>

                    <div class="control-group">
                        <label class="control-label">
                            <span>Радіус</span>
                            <span class="control-value">@Context.ObstacleRadius.ToString("F1")</span>
                        </label>
                        <input type="range" class="form-range" min="1" max="15" step="0.5" @bind-value="Context.ObstacleRadius" @bind-value:event="oninput" />
                    </div>

                    <div class="control-group">
                        <label class="control-label">
                            <span>Вага</span>
                            <span class="control-value">@Context.ObstacleWeight.ToString("N0")</span>
                        </label>
                        <input type="range" class="form-range" min="10000" max="100000" step="5000" @bind-value="Context.ObstacleWeight" @bind-value:event="oninput" />
                    </div>
                </section>
            }

            <section class="control-section">
                <h3 class="section-title">Початковий стан</h3>
                <div class="control-group">
                    <label class="control-label">
                        <span>Швидкість</span>
                        <span class="control-value">@InitialVelocity.ToString("F1")</span>
                    </label>
                    <input type="range" class="form-range" min="0" max="20" step="0.5" @bind-value="InitialVelocity" @bind-value:event="oninput" />
                </div>
                <div class="control-group">
                    <label class="control-label">
                        <span>Кут</span>
                        <span class="control-value">@InitialAngle.ToString("F2")</span>
                    </label>
                    <input type="range" class="form-range" min="-3.14" max="3.14" step="0.01" @bind-value="InitialAngle" @bind-value:event="oninput" />
                </div>
            </section>

            @if (_currentCar != null)
            {
                <div class="telemetry-panel">
                    <h3 class="telemetry-title">Телеметрія</h3>
                    <div class="telemetry-grid">
                        <div class="telemetry-item">
                            <div class="telemetry-label">X</div>
                            <div class="telemetry-value">@(_currentCar.X.ToString("F2"))</div>
                        </div>
                        <div class="telemetry-item">
                            <div class="telemetry-label">Y</div>
                            <div class="telemetry-value">@(_currentCar.Y.ToString("F2"))</div>
                        </div>
                        <div class="telemetry-item">
                            <div class="telemetry-label">Швидкість</div>
                            <div class="telemetry-value">@(Math.Abs(_currentCar.Velocity).ToString("F2"))</div>
                        </div>
                        <div class="telemetry-item">
                            <div class="telemetry-label">Кут</div>
                            <div class="telemetry-value">@(_currentCar.Theta.ToString("F2"))</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private enum InteractionMode { None, AddObstacle, SetStart }
    private InteractionMode _mode = InteractionMode.None;

    private Timer? _timer;
    private CarStateDTO? _currentCar;
    private DotNetObjectReference<ParkingVisualizer>? _objRef;
    private int _draggedIdx = -1;

    private double InitialVelocity { get; set; } = 0.0;
    private double InitialAngle { get; set; } = 0.0;

    private ParkingScenario? Context => Sim.ActiveScenario as ParkingScenario;

    protected override async Task OnInitializedAsync()
    {
        Sim.LoadScenario("parking");
        Sim.Dt = 0.1;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initCanvasEvents", "simCanvas", _objRef);
            await Tick();
        }
    }

    private void SetCarType(Enums.CarType type)
    {
        if (Context != null)
        {
            Context.CurrentCarType = type;
        }
    }

    private void Start()
    {
        if (_timer != null)
        {
            return;
        }
        _timer = new Timer(100);
        _timer.Elapsed += async (s, e) => await Tick();
        _timer.Start();
    }

    private async Task Tick()
    {
        BaseStateDTO baseDto;
        if (_timer != null)
        {
            baseDto = Sim.RunStep();
        }
        else
        {
            baseDto = Sim.GetCurrentState();
        }

        _currentCar = MapBaseToCar(baseDto);

        var obstacles = Sim.GetCurrentVisuals();
        await JS.InvokeVoidAsync("drawParking", "simCanvas", _currentCar, obstacles);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task HandleMouseDown(double x, double y)
    {
        if (_mode == InteractionMode.AddObstacle)
        {
            Sim.HandleInteraction(x, y, "AddObstacle");
            _mode = InteractionMode.None;
            await Tick();
            return;
        }

        if (_mode == InteractionMode.SetStart)
        {
            try
            {
                Sim.SetState(new double[] { x, y, InitialVelocity, InitialAngle });
            }
            catch
            {
                
            }

            _mode = InteractionMode.None;
            await Tick();
            return;
        }

        if (Context != null)
        {
            var obstacles = Context.GetVisualizationData() as List<Obstacle>;
            if (obstacles != null)
            {
                _draggedIdx = -1;
                for (int i = 0; i < obstacles.Count; i++)
                {
                    double dist = Math.Sqrt(Math.Pow(x - obstacles[i].X, 2) + Math.Pow(y - obstacles[i].Y, 2));
                    if (dist < obstacles[i].Radius)
                    {
                        _draggedIdx = i;
                        break;
                    }
                }
            }
        }
    }

    [JSInvokable]
    public async Task HandleRightClick(double x, double y)
    {
        Sim.HandleInteraction(x, y, "RemoveObstacle");
        await Tick();
    }

    [JSInvokable]
    public async Task HandleMouseMove(double x, double y)
    {
        if (_draggedIdx != -1 && Context != null)
        {
            Context.UpdateObstacle(_draggedIdx, x, y);
            await Tick();
        }
    }

    [JSInvokable]
    public void HandleMouseUp() => _draggedIdx = -1;

    private void SetAddObstacleMode() => _mode = (_mode == InteractionMode.AddObstacle) ? InteractionMode.None : InteractionMode.AddObstacle;
    private void SetStartPositionMode() => _mode = (_mode == InteractionMode.SetStart) ? InteractionMode.None : InteractionMode.SetStart;

    private async Task ClearObstacles()
    {
        if (Context != null) 
        {
            Context.Reset();
        }
        await Tick();
    }

    private void Stop() { _timer?.Stop(); _timer = null; }
    private void Reset() { Stop(); Sim.Reset(); _currentCar = null; _ = Tick(); }

    private CarStateDTO MapBaseToCar(BaseStateDTO baseDto)
    {
        var car = new CarStateDTO();
        car.State = new double[4];
        car.Control = new double[2];

        if (baseDto?.State != null)
        {
            for (int i = 0; i < Math.Min(baseDto.State.Length, 4); ++i)
            {
                car.State[i] = baseDto.State[i];
            }
        }
        if (baseDto?.Control != null)
        {
            for (int i = 0; i < Math.Min(baseDto.Control.Length, 2); ++i)
            {
                car.Control[i] = baseDto.Control[i];
            }
        }
        return car;
    }

    public void Dispose() { _timer?.Dispose(); _objRef?.Dispose(); }
}