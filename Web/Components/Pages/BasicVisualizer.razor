@page "/basicvisualizer"
@inject SimulationService Sim
@inject IJSRuntime JS
@using System.Timers
@using Core
@using Web.Data
@using Web.Services
@using Web.Services.Scenarios
@implements IDisposable

<div class="container-fluid">
    <div class="row">
        <div class="col-md-9 text-center p-3">
            <h3>MPC Path Tracking (Parking)</h3>
            <div class="alert alert-info py-1 mb-2">
                <small><strong>Drag</strong> obstacles to move | <strong>Right-Click</strong> an obstacle to delete it.</small>
            </div>

            <canvas id="simCanvas" width="800" height="600" style="border:1px solid #000; background: #f8f9fa; cursor: default;"></canvas>

            <div class="mt-3">
                <button class="btn btn-success" @onclick="Start">Start</button>
                <button class="btn btn-danger" @onclick="Stop">Stop</button>
                <button class="btn btn-secondary" @onclick="Reset">Reset</button>

                <div class="btn-group ms-3">
                    <button class="btn @(_mode == InteractionMode.AddObstacle ? "btn-warning" : "btn-info")" @onclick="SetAddObstacleMode">
                        @(_mode == InteractionMode.AddObstacle ? "Cancel Add" : "Add Obstacle")
                    </button>
                    <button class="btn @(_mode == InteractionMode.SetStart ? "btn-warning" : "btn-primary")" @onclick="SetStartPositionMode">
                        @(_mode == InteractionMode.SetStart ? "Cancel Move" : "Move Car")
                    </button>
                </div>
                <button class="btn btn-outline-danger ms-2" @onclick="ClearObstacles">Clear All Obstacles</button>
            </div>
        </div>

        <div class="col-md-3 bg-light vh-100 border-start p-4 shadow-sm text-start" style="overflow-y: auto;">
            <h4 class="mb-4">Control Panel</h4>

            <section class="mb-4">
                <h6 class="text-primary fw-bold">Initial State (For "Move Car")</h6>
                <div class="mb-3">
                    <label class="form-label small">Initial Velocity: <strong>@InitialVelocity.ToString("F1") m/s</strong></label>
                    <input type="range" class="form-range" min="0" max="20" step="0.5" @bind-value="InitialVelocity" @bind-value:event="oninput" />
                </div>
                <div class="mb-3">
                    <label class="form-label small">Initial Angle: <strong>@InitialAngle.ToString("F2") rad</strong></label>
                    <input type="range" class="form-range" min="-3.14" max="3.14" step="0.01" @bind-value="InitialAngle" @bind-value:event="oninput" />
                </div>
            </section>

            <hr />

            @if (Context != null)
            {
                <section class="mb-4">
                    <h6 class="text-secondary fw-bold">MPC Algorithm</h6>
                    <div class="mb-3">
                        <label class="form-label small">Horizon: <strong>@Context.Horizon</strong></label>
                        <input type="range" class="form-range" min="5" max="100" step="1" @bind-value="Context.Horizon" @bind-value:event="oninput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Time Step (dt): <strong>@Sim.Dt.ToString("F2")s</strong></label>
                        <input type="range" class="form-range" min="0.05" max="0.5" step="0.01" @bind-value="Sim.Dt" @bind-value:event="oninput" />
                    </div>
                </section>

                <hr />

                <section class="mb-4">
                    <h6 class="text-danger fw-bold">Obstacle Parameters</h6>
                    <div class="mb-3">
                        <label class="form-label small">New Radius: <strong>@Context.ObstacleRadius.ToString("F1")m</strong></label>
                        <input type="range" class="form-range" min="1" max="15" step="0.5" @bind-value="Context.ObstacleRadius" @bind-value:event="oninput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Weight: <strong>@Context.ObstacleWeight.ToString("N0")</strong></label>
                        <input type="range" class="form-range" min="1000" max="50000" step="1000" @bind-value="Context.ObstacleWeight" @bind-value:event="oninput" />
                    </div>
                </section>
            }

            @if (_currentCar != null)
            {
                <div class="card bg-dark text-white p-2 mt-auto">
                    <h6 class="mb-1 small">Live Telemetry</h6>
                    <code class="text-info" style="font-size: 0.75rem;">
                        X: @(_currentCar.X.ToString("F2"))<br />
                        Y: @(_currentCar.Y.ToString("F2"))<br />
                        V: @(_currentCar.Velocity.ToString("F2"))<br />
                        A: @(_currentCar.Theta.ToString("F2"))
                    </code>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private enum InteractionMode { None, AddObstacle, SetStart }
    private InteractionMode _mode = InteractionMode.None;

    private Timer? _timer;
    private CarStateDTO? _currentCar;
    private DotNetObjectReference<BasicVisualizer>? _objRef;
    private int _draggedIdx = -1;

    // local initial state values (don't rely on SimulationService internals)
    private double InitialVelocity { get; set; } = 0.0;
    private double InitialAngle { get; set; } = 0.0;

    // Helper to get typed scenario
    private ParkingScenario? Context => Sim.ActiveScenario as ParkingScenario;

    protected override async Task OnInitializedAsync()
    {
        // Force parking mode when this page loads
        Sim.LoadScenario("parking");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initCanvasEvents", "simCanvas", _objRef);
            await Tick();
        }
    }

    private void Start()
    {
        if (_timer != null) return;
        _timer = new Timer(100);
        _timer.Elapsed += async (s, e) => await Tick();
        _timer.Start();
    }

    private async Task Tick()
    {
        // RunStep returns BaseStateDTO (scenario-specific subclass sometimes)
        BaseStateDTO baseDto;
        if (_timer != null)
        {
            baseDto = Sim.RunStep();
        }
        else
        {
            baseDto = Sim.GetCurrentState();
        }

        _currentCar = MapBaseToCar(baseDto);

        var obstacles = Sim.GetCurrentVisuals();
        // Using parking.js function — drawCar expects CarStateDTO
        await JS.InvokeVoidAsync("drawParking", "simCanvas", _currentCar, obstacles);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task HandleMouseDown(double x, double y)
    {
        if (_mode == InteractionMode.AddObstacle)
        {
            Sim.HandleInteraction(x, y, "AddObstacle");
            _mode = InteractionMode.None;
            await Tick();
            return;
        }

        if (_mode == InteractionMode.SetStart)
        {
            // Set the full car state: [x, y, initialVelocity, initialAngle]
            try
            {
                Sim.SetState(new double[] { x, y, InitialVelocity, InitialAngle });
            }
            catch
            {
            }

            _mode = InteractionMode.None;
            await Tick();
            return;
        }

        // Check for drag start
        if (Context != null)
        {
            var obstacles = Context.GetVisualizationData() as List<Obstacle>;
            if (obstacles != null)
            {
                _draggedIdx = -1;
                for (int i = 0; i < obstacles.Count; i++)
                {
                    double dist = Math.Sqrt(Math.Pow(x - obstacles[i].X, 2) + Math.Pow(y - obstacles[i].Y, 2));
                    if (dist < obstacles[i].Radius)
                    {
                        _draggedIdx = i;
                        break;
                    }
                }
            }
        }
    }

    [JSInvokable]
    public async Task HandleRightClick(double x, double y)
    {
        Sim.HandleInteraction(x, y, "RemoveObstacle");
        await Tick();
    }

    [JSInvokable]
    public async Task HandleMouseMove(double x, double y)
    {
        if (_draggedIdx != -1 && Context != null)
        {
            Context.UpdateObstacle(_draggedIdx, x, y);
            await Tick();
        }
    }

    [JSInvokable]
    public void HandleMouseUp() => _draggedIdx = -1;

    private void SetAddObstacleMode() => _mode = (_mode == InteractionMode.AddObstacle) ? InteractionMode.None : InteractionMode.AddObstacle;
    private void SetStartPositionMode() => _mode = (_mode == InteractionMode.SetStart) ? InteractionMode.None : InteractionMode.SetStart;

    private async Task ClearObstacles()
    {
        if (Context != null) Context.Reset();
        await Tick();
    }

    private void Stop() { _timer?.Stop(); _timer = null; }
    private void Reset() { Stop(); Sim.Reset(); _currentCar = null; _ = Tick(); }

    private CarStateDTO MapBaseToCar(BaseStateDTO baseDto)
    {
        var car = new CarStateDTO();
        // ensure arrays exist with expected sizes
        car.State = new double[4];
        car.Control = new double[2];

        if (baseDto?.State != null)
        {
            for (int i = 0; i < Math.Min(baseDto.State.Length, 4); i++)
                car.State[i] = baseDto.State[i];
        }
        if (baseDto?.Control != null)
        {
            for (int i = 0; i < Math.Min(baseDto.Control.Length, 2); i++)
                car.Control[i] = baseDto.Control[i];
        }
        return car;
    }

    public void Dispose() { _timer?.Dispose(); _objRef?.Dispose(); }
}
